{
  "name": "onsei-lrn",
  "version": "0.3.0",
  "private": true,
  "description": "Learn a PDF by explaining it out loud: AI feedback until you get it right, then flashcards in your own words",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/unit/*.test.js test/api.test.js test/api-claude.test.js",
    "test:e2e": "node test/e2e/run.mjs",
    "setup": "bash scripts/mac/install.sh",
    "uninstall": "bash scripts/mac/uninstall.sh",
    "update": "bash scripts/mac/update.sh",
    "restart": "bash scripts/mac/restart.sh",
    "logs": "tail -n 50 -f \"$HOME/Library/Logs/ONSEI_LRN/server.log\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
